{
  "aws": {
    "region": "us-east-1",
    "bucket_name": "cloud-document-analyzer-sebastian",
    "table_name": "DocumentAnalyses"
  },
  "application": {
    "upload_prefix": "uploads/",
    "presigned_url_expiration": 300,
    "history_limit": 20
  },
  "cors": {
    "allow_origin": "*",
    "allow_headers": "Content-Type,Authorization",
    "allow_methods": "OPTIONS,POST,GET"
  }
}